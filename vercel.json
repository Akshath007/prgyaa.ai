{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/pragyaa_dashboard/static/index.html" },
    { "source": "/api/samples", "destination": "/pragyaa_dashboard/static/audio/samples_metadata.json" },
    { "source": "/static/(.*)", "destination": "/pragyaa_dashboard/static/$1" },
    { "source": "/(.*)", "destination": "/pragyaa_dashboard/static/$1" }
  ]
}
